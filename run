#!/bin/bash

EXEC=""
TARGET="buildScript"
ORIG_ARGS="$*"
declare -a PARAMS

for e in "$@"; do
  TARGET="$TARGET/$e"
  PARAMS+=("$e")
  if [ -x "${TARGET}.sh" ]; then
    EXEC="${TARGET}.sh"
    PARAMS=()
  fi
done

if [ -z "$EXEC" ]; then
  echo "no matching build script for: $ORIG_ARGS" >&2
  exit 1
fi

echo ">> $EXEC"
exec "$EXEC" "${PARAMS[@]}"
